# ---------------------------------------------------------------------------
# Gemini (required). Server-side only; never exposed to the browser.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides for the model chain. The default chain was chosen by
# `npm run eval` (see docs/RECOMMENDATION_ENGINE.md):
#   gemini-3.1-flash-lite -> gemini-3.5-flash-lite -> gemini-2.5-flash
# GEMINI_MODEL is tried first, then GEMINI_FALLBACK_MODELS in order.
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash

# How many profiles to send Gemini per request (default 20; 0 = whole catalog).
# The shortlist only applies when the brief has strong keyword matches;
# abstract briefs always get the whole catalog.
# RECOMMEND_CANDIDATES=20

# Daily cap on query embeddings for semantic font search (GET /api/fonts),
# shared across instances via Supabase (default 500). The free tier allows
# ~1,000 embeds/day per key, and `npm run seed` / `npm run build-index` use the
# same key, so leave them headroom. Over the cap, search falls back to fuzzy.
# EMBED_DAILY_LIMIT=500

# ---------------------------------------------------------------------------
# Supabase (PostgreSQL + pgvector). Optional locally, needed in production for
# the recommendation cache, feedback learning, history and favourites.
# Get these from Supabase Project Settings -> API.
# The server needs SUPABASE_SERVICE_ROLE_KEY for writes. With only the anon key,
# RLS blocks writes and the app falls back to in-memory storage.
# Never expose the service role key to the browser.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Extra browser origins allowed to call the API (comma-separated).
# fontally.vercel.app, its preview URLs and localhost are always allowed.
# ALLOWED_ORIGINS=https://fontally.example.com
